{% extends 'base.html.twig' %}

{% block title %} Profile {% endblock%}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('css/style-profile.css') }}">
{% endblock%}

{% block body %}
    <div class="main-layout">
        <header class="header">
            <h1>Profile</h1>
        </header>
        <div class="main-content">
            {% if usuario is not null %}
                <div class="profile-content">
                    <img src="{{ asset('images/' ~ usuario.imagePath) }}" alt="profile image" id="profile-image">
                    <div class="profile-information">
                        <h2>{{ usuario.name }}</h2>
                        <p>{{ usuario.gender }}</p>
                        <p>{{ usuario.age }}</p>
                        <p>{{ usuario.description }}</p>
                    </div>
                </div>
            {% else %}
                <div class="profile-content">
                    <p>No se ha encontrado el usuario</p>
                </div>
            {% endif %}

            <div class="profile-actions">
                <button id="edit" onclick="window.location.href='{{ path('app_profile_edit') }}'">Edit</button>
                <form method="post" action="{{ path('app_profile_remove') }}" onsubmit="return confirm('¿Estás seguro de que deseas eliminar tu cuenta?');">
                    <button type="submit" id="remove">Remove</button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
