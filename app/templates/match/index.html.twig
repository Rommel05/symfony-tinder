{% extends 'base.html.twig' %}

{% block title %}Match{% endblock %}
{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('css/style-form.css') }}">
{% endblock %}
{% block body %}
    {% if pairs is not empty %}
        <ul>
            {% for pair in pairs %}
                <li> <a href={{ path('app_message', { id: pair.userB.id }) }}>{{ pair.userB.name }}</a> </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>No tienes ningún match</p>
    {% endif %}
{% endblock %}
